{
  "name": "wurzelwerk",
  "version": "0.1.0",
  "private": true,
  "description": "Lokale Desktop-Anwendung für Ahnenforschung",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "electron-vite dev",
    "typen": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "lint": "eslint .",
    "grenzen": "depcruise src --config .dependency-cruiser.cjs",
    "grenzen:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -Tsvg -o artefakte/abhaengigkeiten.svg",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:budget": "vitest run --passWithNoTests test/budget",
    "trigger": "tsx skripte/trigger-generieren.ts",
    "schema:dump": "tsx skripte/schema-dump.ts",
    "fixture:db": "tsx skripte/fixture-datenbank-bauen.ts",
    "pruefe": "pnpm typen && pnpm lint && pnpm grenzen && pnpm test",
    "build": "electron-vite build && electron-builder",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "uuid": "^11.0.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
